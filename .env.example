# =================================================================
# IHMS ERP — Environment Configuration
# =================================================================

# Server Port
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection
# Specify either a full DATABASE_URL or individual DB_* parameters:
# Example: DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ihms_db
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ihms_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# JWT Secrets for Multi-Tenant Auth
JWT_SECRET=ihms-super-secret-production-key-2026
JWT_REFRESH_SECRET=ihms-refresh-secret-production-key-2026
JWT_EXPIRES_IN=7d

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Communication Integrations (Ready for Production APIs)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASSWORD=
SMS_API_KEY=
WHATSAPP_API_KEY=

# Cashfree Multi-Tenant Platform & Easy Split Payment Configuration
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2023-08-01
CASHFREE_ENV=TEST
CASHFREE_WEBHOOK_SECRET=